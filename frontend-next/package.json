{
  "name": "url-link-frontend-next",
  "version": "1.0.0",
  "private": true,
  "author": "GILAD",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "reinstall": "rm -rf .next pnpm-lock.yaml node_modules && pnpm i",
    "reinstall:full": "rm -rf pnpm-lock.yaml .next .turbo node_modules && pnpm store prune && pnpm i",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "dev": "next dev  --port 5555",
    "build": "next build",
    "start": "next start",
    "format": "npx prettier --write .",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.8",
    "@mui/material": "7.3.8",
    "@mui/material-nextjs": "^7.3.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@vercel/analytics": "^1.6.1",
    "ag-grid-community": "35.1.0",
    "ag-grid-react": "35.1.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.5",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "react": "19.2.4",
    "react-apexcharts": "^1.9.0",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "1.58.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all"
  ],
  "packageManager": "pnpm@10.8.1"
}
